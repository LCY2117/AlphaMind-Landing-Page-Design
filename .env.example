# AlphaMind data integration mode.
# mock: local demo data, always works.
# quantdinger: call a local QuantDinger backend when available.
VITE_ALPHAMIND_DATA_MODE=mock

# QuantDinger default UI/proxy URL is usually http://localhost:8888.
# Backend direct URL may be http://localhost:5000 when calling Flask directly.
VITE_QUANTDINGER_BASE_URL=http://localhost:8888

# Optional: read/backtest-scoped QuantDinger Agent Gateway token.
# Recommended scopes for AlphaMind: R,B only. Avoid T/C scopes.
# VITE_QUANTDINGER_AGENT_TOKEN=qd_agent_xxx

# Optional: human JWT for /api/fast-analysis/analyze.
# Use only in local testing; do not commit real tokens.
# VITE_QUANTDINGER_AUTH_TOKEN=eyJ...

# Server-only AI chat provider.
# Do not prefix with VITE_. Do not commit a real key.
SILICONFLOW_API_KEY=
SILICONFLOW_FAST_MODEL=Qwen/Qwen2.5-7B-Instruct
SILICONFLOW_DEEP_MODEL=Pro/zai-org/GLM-4.7
SILICONFLOW_VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct
SILICONFLOW_VISION_DEEP_MODEL=Qwen/Qwen3-VL-8B-Thinking
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1/chat/completions

# Server-only market data providers for Asset X-Ray.
# Do not prefix with VITE_. Do not commit real keys.
FINNHUB_API_KEY=
FINNHUB_BASE_URL=https://finnhub.io/api/v1
TWELVE_DATA_API_KEY=
TWELVE_DATA_BASE_URL=https://api.twelvedata.com
NEWSAPI_KEY=
NEWSAPI_BASE_URL=https://newsapi.org
